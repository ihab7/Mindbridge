# MindBridge — Environment Variables
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# On Vercel, set these under Project Settings → Environment Variables.
#
# This list reflects the variables actually read by the codebase
# (checked via `grep -r process.env`). Do not add unused variables —
# MindBridge does not use NextAuth, JWT, or any external AI API today.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# PostgreSQL connection string, read by lib/db.ts via @neondatabase/serverless.
# Must be a Neon (or Neon-compatible HTTP-driver) Postgres connection string.
# Get this from your Neon project dashboard → Connection Details.
# Include ?sslmode=require (Neon requires SSL).
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ---------------------------------------------------------------------------
# Google Maps (required for the "Find a Psychiatrist Near You" directory)
# ---------------------------------------------------------------------------
# Client-side Google Maps JavaScript API key, read by
# components/psychiatrist/practitioner-map.tsx (map + markers) and
# app/join/page.tsx (address -> lat/lng geocoding on the registration form).
# Must be prefixed NEXT_PUBLIC_ to be exposed to the browser bundle.
# Get one from https://console.cloud.google.com/google/maps-apis and enable
# the "Maps JavaScript API" and "Geocoding API".
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# ---------------------------------------------------------------------------
# Automatically provided — do not set manually
# ---------------------------------------------------------------------------
# NODE_ENV is set automatically by Next.js/Vercel (development, production).
# lib/auth.ts reads it to decide whether the session cookie is marked `secure`.
